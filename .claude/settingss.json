{
  "permissions": {
    "allow": [
      "Bash(node --check *)",
      "Bash(node scripts/validate-workflow.mjs *)",
      "Bash(node scripts/hook-selftest.mjs)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(ls *)",
      "Bash(grep *)",
      "Bash(find *)"
    ],
    "deny": [
      "Edit(./prd-generator/.claude/**)",
      "Edit(./experts/**)",
      "Edit(./scripts/**)",
      "Edit(./.claude/settings.json)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hook-validate.mjs"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hook-stop-audit.mjs"
          }
        ]
      }
    ]
  }
}
